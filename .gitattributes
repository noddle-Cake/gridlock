# Normalize line endings so the repo behaves the same on Windows, macOS, Linux and in
# the Linux containers deployed to Lightsail (a CRLF shell script or Caddyfile breaks there).
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.pdf binary
*.xlsx binary
*.gz binary
*.png binary
*.ico binary
# Generated by frontend/scripts/build-basemap.mjs: minified, one line each, not worth diffing.
frontend/public/basemap/*.json -diff linguist-generated=true
