DATABASE_URL=postgresql://gridmerge:gridmerge@localhost:5432/gridmerge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# nominatim | none  (none = county gazetteer only)
GEOCODER=nominatim
CORS_ORIGINS=http://localhost:5173
# Sign-in: set both to require it; leave either empty for an open app.
AUTH_USERNAME=
AUTH_PASSWORD=
# Signs session cookies; empty = random per process (a restart signs everyone out).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
