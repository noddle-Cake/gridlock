# SITE_ADDRESS set to a hostname (e.g. 3-90-12-34.sslip.io or gridlock.example.com)
# gets an automatic Let's Encrypt certificate; unset, Compose passes :80 (plain HTTP).
{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy app:8000
}

# www.<host> gets its own certificate and redirects to the bare host. With :80 this
# becomes a "www." host route that never matches, so plain-HTTP mode is unaffected.
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
