# Copy to deploy/.env (git-ignored) to run the production stack locally:
#   docker build -f backend/Dockerfile -t gridlock:local .
#   docker compose -p gridlock-local -f deploy/docker-compose.yml --env-file deploy/.env up -d
# On the Lightsail instance CI writes ~/gridlock/.env itself from the repo secrets.
APP_TAG=local
# Letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Requests per minute (free tier: 5). Raise on a paid key; 0 disables pacing.
GEMINI_RPM=5
# ":80" = plain HTTP; a hostname pointed at the server gets automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
